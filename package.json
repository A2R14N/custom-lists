{
  "name": "custom-lists",
  "version": "1.3.0",
  "private": true,
  "description": "User-owned cached MDBList, TMDB and legacy Trakt catalogs for Stremio and Nuvio",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:ui": "npm --prefix vue run dev",
    "setup": "npm ci && npm --prefix vue ci",
    "build": "npm --prefix vue run build",
    "typecheck": "npm --prefix vue run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "license": "ISC",
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@upstash/redis": "^1.36.2",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.1",
    "fflate": "0.8.3"
  },
  "engines": {
    "node": "24.x"
  }
}
